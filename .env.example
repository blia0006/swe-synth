####################################################################
# 课题三：数据合成 —— 凭证配置模板
#
# 用法：cp .env.example .env  然后填入真实值
# ⚠️ .env 绝对不要提交 Git（已在 .gitignore 中忽略）
#
# 拿不到值的先留空，check_env.py 会跳过对应检查并提示去哪里拿
####################################################################

# ------------------------------------------------------------------
# 1) TokenHub —— LLM 网关（Agent1 出题用）
#    Key 获取：内部平台申请 / 问导师
# ------------------------------------------------------------------
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
TOKENHUB_API_KEY=
TOKENHUB_MODEL=deepseek-v4-pro-202606
# 备选模型：glm-5

# 【规模化扩展用，可选】多 Key 轮转：逗号分隔填多个 Key，出题吞吐随 Key 数线性提升
# （每个 Key 独立计入平台 QPM=60 限流，见 swe_synth/clients/tokenhub_pool.py）。
# 设置了它就会覆盖上面单 Key 的 TOKENHUB_API_KEY；只有单 Key 时留空即可，行为不变。
# TOKENHUB_API_KEYS=key1,key2,key3

# ------------------------------------------------------------------
# 2) 腾讯云 Agent Sandbox（AGS）—— Agent2 验证用
#    E2B_API_KEY 获取：AGS 控制台 → API Keys → 新建
#      https://console.cloud.tencent.com/ags/sandbox
#    E2B_DOMAIN 为固定值，作用是把 E2B SDK 指向腾讯云而非 E2B 官方
# ------------------------------------------------------------------
E2B_API_KEY=
E2B_DOMAIN=ap-guangzhou.tencentags.com
# 沙箱工具名称（= E2B 的 template）。先在控制台建一个内置 code-interpreter 工具练手
AGS_SANDBOX_TEMPLATE=

# ------------------------------------------------------------------
# 3) 腾讯云 OpenAPI 密钥 —— TCCLI / Python SDK / 创建沙箱工具用
#    获取：控制台 → 访问管理 CAM → 访问密钥 → API 密钥管理
#      https://console.cloud.tencent.com/cam/capi
# ------------------------------------------------------------------
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou

# CAM 角色 ARN（载体选「Agent Runtime」的那个角色，创建沙箱工具时要传）
# 形如：qcs::cam::uin/100051554448:roleName/ags-tcr-pull
AGS_ROLE_ARN=

# ------------------------------------------------------------------
# 4) 容器镜像服务 —— 存题目镜像
#    企业版 TCR：域名形如 xxx.tencentcloudcr.com，凭证用「长期访问凭证」
#    个人版 CCR：域名为 ccr.ccs.tencentyun.com，凭证用「访问凭证」
#    获取：容器镜像服务 → 选实例 → 访问凭证（页面会直接给出 docker login 命令）
# ------------------------------------------------------------------
TCR_REGISTRY=ccr.ccs.tencentyun.com
TCR_NAMESPACE=tcb-100008634787-zbaf
TCR_USERNAME=
TCR_PASSWORD=
# personal（个人版 CCR）/ enterprise（企业版 TCR），影响创建沙箱工具的 ImageRegistryType
TCR_REGISTRY_TYPE=personal

# 沙箱基础镜像：自定义题目镜像必须 FROM 它，否则无法作为沙箱工具启动
SANDBOX_BASE_IMAGE=ccr.ccs.tencentyun.com/ags-image/sandbox-code:latest

# ------------------------------------------------------------------
# 5) GitHub —— 仓库 clone + 无重叠交叉比对检索 + 仓库池自动发现（scripts/discover_repos.py）
#    获取：github.com → Settings → Developer settings → PAT
#    权限：只需 public_repo 读权限
#    ⚠️ 未认证时搜索 API 限流极低（10 req/min），仓库池自动发现基本不可用，务必配置
# ------------------------------------------------------------------
GITHUB_TOKEN=

# ------------------------------------------------------------------
# 6) 构建机 —— 题目镜像的 docker build/push 在这里执行
#    详见 README.md §4.3「构建环境：docker build 到底在哪里执行」
#
#    为什么需要它：
#      · 开发机若是 Apple Silicon(arm64)，而 AGS 沙箱只接受 linux/amd64，
#        跨架构构建走 QEMU 模拟，慢到不可用
#      · AGS 沙箱内没有 docker CLI，也未注入 /var/run/docker.sock（已实测），
#        因此 build 不能放在沙箱内执行
#
#    取值：
#      · 远端构建机（推荐）：DOCKER_HOST=ssh://root@<构建机IP>
#        或在 ~/.ssh/config 配好 Host 别名后：DOCKER_HOST=ssh://docker-builder
#        （需先配置 SSH 免密登录）
#      · 本机为 x86_64 时：留空即可，直接用本机 Docker
#
#    构建机参考规格：2 核 / 3.5GB 内存 / 50GB 磁盘
#    ⚠️ 磁盘需留足：每个题目镜像约 7.5GB（平台强制继承的官方基础镜像即 6.86GB）
# ------------------------------------------------------------------
# DOCKER_HOST=
