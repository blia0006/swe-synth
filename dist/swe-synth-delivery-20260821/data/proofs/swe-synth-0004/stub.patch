+# SPDX-FileCopyrightText: 2024 Example
+#
+# SPDX-License-Identifier: Apache-2.0
+from __future__ import annotations
+
+from collections.abc import Mapping
+from urllib.parse import SplitResult, urlencode, urlsplit, urlunsplit
+
+
+class CacheKeySerializer:
+    """Serialize a request into a stable cache key string.
+
+    The serializer converts a method, URL, headers, and optional
+    request body into a deterministic string. All components are
+    normalized before hashing to ensure that semantically equivalent
+    requests produce the same key.
+    """
+
+    def serialize(
+        self,
+        method: str,
+        url: str,
+        headers: Mapping[str, str],
+        body: bytes | None = None,
+    ) -> str:
+        """Return a stable string key for the given request parts.
+
+        Args:
+            method: HTTP method, case-insensitive; upper-cased internally.
+            url: Full URL including scheme, host, path, and query.
+            headers: Mapping of header names to values. Header names are
+                normalized to lower-case for key generation.
+            body: Optional request body bytes. If ``None`` or empty, the
+                body component is omitted from the key.
+
+        Returns:
+            A SHA-256 hexadecimal digest representing the normalized
+            request.
+
+        Raises:
+            ValueError: If ``method`` is empty after stripping, or if
+                ``url`` cannot be parsed into scheme, netloc, and path.
+        """
+        raise NotImplementedError(
+            "CacheKeySerializer.serialize must be implemented"
+        )
