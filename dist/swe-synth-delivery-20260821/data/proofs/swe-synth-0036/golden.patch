--- a/cachecontrol/http_date_utils.py
+++ b/cachecontrol/http_date_utils.py
@@ -2,6 +2,25 @@
 #
 # SPDX-License-Identifier: Apache-2.0
 from __future__ import annotations
+
+import re
+from datetime import datetime, timezone
+
+# Month abbreviations to month numbers
+_MONTHS = {
+    "Jan": 1, "Feb": 2, "Mar": 3, "Apr": 4, "May": 5, "Jun": 6,
+    "Jul": 7, "Aug": 8, "Sep": 9, "Oct": 10, "Nov": 11, "Dec": 12,
+}
+
+_IMF_FIXDATE_RE = re.compile(
+    r"^[A-Z][a-z]{2}, (\d{2}) ([A-Z][a-z]{2}) (\d{4}) (\d{2}):(\d{2}):(\d{2}) GMT$"
+)
+_RFC850_RE = re.compile(
+    r"^[A-Z][a-z]{2,8}, (\d{2})-([A-Z][a-z]{2})-(\d{2}) (\d{2}):(\d{2}):(\d{2}) GMT$"
+)
+_ASCTIME_RE = re.compile(
+    r"^[A-Z][a-z]{2} ([A-Z][a-z]{2}) ([ \d]\d) (\d{2}):(\d{2}):(\d{2}) (\d{4})$"
+)
 
 
 def parse_http_date(date_str: str) -> int:
@@ -12,7 +31,49 @@
     Returns the timestamp as an integer number of seconds since the Unix epoch.
     Raises ValueError if the string cannot be parsed.
     """
-    raise NotImplementedError
+    match = _IMF_FIXDATE_RE.match(date_str)
+    if match:
+        day, mon, year, hour, minute, second = match.groups()
+        month = _MONTHS.get(mon)
+        if month is None:
+            raise ValueError(f"Invalid HTTP date: {date_str!r}")
+        dt = datetime(
+            int(year), month, int(day), int(hour), int(minute), int(second),
+            tzinfo=timezone.utc,
+        )
+        return int(dt.timestamp())
+
+    match = _RFC850_RE.match(date_str)
+    if match:
+        day, mon, year2, hour, minute, second = match.groups()
+        month = _MONTHS.get(mon)
+        if month is None:
+            raise ValueError(f"Invalid HTTP date: {date_str!r}")
+        year = int(year2)
+        if year < 70:
+            year += 2000
+        else:
+            year += 1900
+        dt = datetime(
+            year, month, int(day), int(hour), int(minute), int(second),
+            tzinfo=timezone.utc,
+        )
+        return int(dt.timestamp())
+
+    match = _ASCTIME_RE.match(date_str)
+    if match:
+        mon, day, hour, minute, second, year = match.groups()
+        month = _MONTHS.get(mon)
+        if month is None:
+            raise ValueError(f"Invalid HTTP date: {date_str!r}")
+        day = day.strip()
+        dt = datetime(
+            int(year), month, int(day), int(hour), int(minute), int(second),
+            tzinfo=timezone.utc,
+        )
+        return int(dt.timestamp())
+
+    raise ValueError(f"Invalid HTTP date: {date_str!r}")
 
 
