+# SPDX-FileCopyrightText: 2024 Eric Larson
+# SPDX-License-Identifier: Apache-2.0
+from __future__ import annotations
+
+from typing import Any
+
+
+class CacheControlDirectives(dict):
+    """A mapping of Cache-Control directives to their values.
+
+    Keys are lowercase directive names. Values are:
+    - True when the directive appears without a parameter
+    - int when the parameter is an integer
+    - str when the parameter is a quoted string or token
+    """
+    def __str__(self) -> str:
+        raise NotImplementedError("__str__ is not implemented")
+
+
+def parse_cache_control(value: str) -> CacheControlDirectives:
+    """Parse a Cache-Control header value into a CacheControlDirectives object.
+
+    Supports multiple directives separated by commas. Directives can have
+    no parameter, an integer parameter, or a quoted string parameter.
+    Keys are lowercased. Later occurrences of a directive override earlier
+    ones. Raises ValueError for malformed input.
+    """
+    raise NotImplementedError("parse_cache_control is not implemented")
+
+
+def merge_cache_control(*directives: CacheControlDirectives) -> CacheControlDirectives:
+    """Merge multiple CacheControlDirectives objects into a new one.
+
+    Later objects override earlier ones for identical directive names.
+    Returns an empty CacheControlDirectives when no arguments are given.
+    """
+    raise NotImplementedError("merge_cache_control is not implemented")
diff --git a/tests/test_cache_control_parser_synth.py b/tests/test_cache_control_parser_synth.py
