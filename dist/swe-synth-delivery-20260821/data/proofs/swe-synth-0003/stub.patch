+++ b/tests/test_cache_control_parser_synth.py
@@ -0,0 +1,67 @@
+# SPDX-FileCopyrightText: 2024 Eric Larson
+# SPDX-License-Identifier: Apache-2.0
+import pytest
+
+from cachecontrol.cache_control_parser import (
+    CacheControlDirectives,
+    merge_cache_control,
+    parse_cache_control,
+)
+
+
+def test_parse_basic_directives():
+    result = parse_cache_control("max-age=3600, no-cache, private")
+    assert isinstance(result, CacheControlDirectives)
+    assert result["max-age"] == 3600
+    assert result["no-cache"] is True
+    assert result["private"] is True
+
+
+def test_parse_quoted_string_with_comma():
+    result = parse_cache_control('no-cache="Set-Cookie, User"')
+    assert result["no-cache"] == "Set-Cookie, User"
+
+
+def test_parse_case_insensitive_and_spaces():
+    result = parse_cache_control("  Max-Age = 300 , No-Store ")
+    assert result["max-age"] == 300
+    assert result["no-store"] is True
+
+
+def test_parse_empty_string():
+    result = parse_cache_control("")
+    assert result == CacheControlDirectives()
+
+
+def test_parse_unclosed_quote_raises():
+    with pytest.raises(ValueError):
+        parse_cache_control('no-cache="abc')
+
+
+def test_parse_empty_name_raises():
+    with pytest.raises(ValueError):
+        parse_cache_control("=3600")
+
+
+def test_merge_overrides():
+    d1 = parse_cache_control("max-age=3600, no-cache")
+    d2 = parse_cache_control("max-age=0, private")
+    merged = merge_cache_control(d1, d2)
+    assert merged["max-age"] == 0
+    assert merged["no-cache"] is True
+    assert merged["private"] is True
+
+
+def test_merge_empty():
+    merged = merge_cache_control()
+    assert merged == CacheControlDirectives()
+
+
+def test_str_sorting_and_formatting():
+    d = parse_cache_control("private, max-age=3600, no-cache")
+    assert str(d) == 'max-age=3600, no-cache, private'
+
+
+def test_str_quoting():
+    d = parse_cache_control('no-cache="abc"')
+    assert str(d) == 'no-cache="abc"'
