+def _derive_concat(salt: t.Any, secret_key: bytes, digest_method: t.Any) -> bytes:
+    return t.cast(bytes, digest_method(salt + secret_key).digest())
+
+
+def _derive_django_concat(salt: t.Any, secret_key: bytes, digest_method: t.Any) -> bytes:
+    return t.cast(bytes, digest_method(salt + b"signer" + secret_key).digest())
+
+
+def _derive_hmac(salt: t.Any, secret_key: bytes, digest_method: t.Any) -> bytes:
+    mac = hmac.new(secret_key, digestmod=digest_method)
+    mac.update(salt)
+    return mac.digest()
+
+
+def _derive_none(salt: t.Any, secret_key: bytes, digest_method: t.Any) -> bytes:
+    return secret_key
+
+
+_DERIVATION_FUNCS: dict[str, t.Callable[..., bytes]] = {
