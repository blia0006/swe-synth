+'''Utilities for parsing and normalizing Internet hostnames.'''
+
+from __future__ import annotations
+
+import ipaddress
+from urllib.parse import urlsplit
+
+from idna import IDNAError, decode, encode
+
+
+def extract_hostname(text: str) -> str:
+    '''Extract and normalize the hostname from a URL or plain hostname string.
+
+    If the input contains a URL scheme (e.g., ``http://``, ``https://``) or
+    starts with ``//``, it is parsed as a URL and the hostname portion is
+    returned. Otherwise the whole input is treated as a bare hostname.
+
+    The returned hostname is normalized by :func:`normalize_hostname`.
+    IP addresses are returned unchanged except for lowercasing.
+
+    Raises:
+        ValueError: If the input is recognized as a URL but no hostname can be
+            extracted from it.
+    '''
+    raise NotImplementedError('TODO: implement extract_hostname')
+
+
+def normalize_hostname(hostname: str, *, keep_unicode: bool = False) -> str:
+    '''Normalize a DNS hostname.
+
+    The following transformations are applied:
+
+    * surrounding whitespace is stripped
+    * trailing dots are removed
+    * letters are lowercased
+    * when *keep_unicode* is ``False``, non-ASCII labels are encoded to
+      IDNA/punycode ASCII and existing punycode labels are left as-is
+    * when *keep_unicode* is ``True``, punycode labels are decoded to Unicode
+      and Unicode input is left as Unicode
+
+    IP address literals are an error. Use :func:`extract_hostname` if the
+    input may be an IP address.
+
+    Raises:
+        ValueError: If the input cannot be normalized (for example, invalid
+            IDNA input).
+    '''
+    raise NotImplementedError('TODO: implement normalize_hostname')
+
+
+def split_domain(hostname: str) -> list[str]:
+    '''Split a DNS hostname into its labels.
+
+    Labels are returned in order from most general to most specific, i.e. the
+    last element is the public suffix.  IPv4/IPv6 addresses are not valid
+    input and will raise :class:`ValueError`.
+
+    Raises:
+        ValueError: If the input cannot be normalized.
+    '''
+    raise NotImplementedError('TODO: implement split_domain')
diff --git a/tests/test_hostname_utils_synth.py b/tests/test_hostname_utils_synth.py
