+++ b/tests/test_hostname_utils_synth.py
@@ -0,0 +1,51 @@
+'''Tests for the hostname utilities module.'''
+
+import pytest
+
+from tldextract.hostname_utils import extract_hostname, normalize_hostname, split_domain
+
+
+def test_extract_hostname_from_url_with_schema_and_port():
+    assert (
+        extract_hostname('https://www.Example.COM:8080/path?q=1')
+        == 'www.example.com'
+    )
+
+
+def test_extract_hostname_from_plain_hostname_string():
+    assert extract_hostname('sub.example.com') == 'sub.example.com'
+
+
+def test_extract_hostname_removes_whitespace_and_trailing_dot():
+    assert extract_hostname('  example.com.  ') == 'example.com'
+
+
+def test_extract_hostname_returns_ipv4_literal_unchanged():
+    assert extract_hostname('http://127.0.0.1:8000/') == '127.0.0.1'
+
+
+def test_extract_hostname_returns_ipv6_literal_unchanged():
+    assert extract_hostname('http://[::1]:8000/') == '::1'
+
+
+def test_extract_hostname_raises_value_error_for_url_without_hostname():
+    with pytest.raises(ValueError):
+        extract_hostname('http://')
+
+
+def test_normalize_hostname_encodes_unicode_to_ascii_punycode():
+    assert normalize_hostname('münchen.com') == 'xn--mnchen-3ya.com'
+
+
+def test_normalize_hostname_keep_unicode_decodes_punycode():
+    assert normalize_hostname('xn--mnchen-3ya.com', keep_unicode=True) == 'münchen.com'
+
+
+def test_normalize_hostname_rejects_ip_address_literal():
+    with pytest.raises(ValueError):
+        normalize_hostname('127.0.0.1')
+
+
+def test_split_domain_returns_labels_and_handles_empty_input():
+    assert split_domain('www.example.com') == ['www', 'example', 'com']
+    assert split_domain('') == []
