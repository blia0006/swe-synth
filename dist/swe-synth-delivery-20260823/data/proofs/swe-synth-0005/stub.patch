+++ b/tests/test_suffix_index_synth.py
@@ -0,0 +1,67 @@
+'''Synthetic tests for tldextract.suffix_index.'''
+
+from tldextract.suffix_index import SuffixIndex
+
+
+def test_empty_rules_returns_none():
+    index = SuffixIndex([])
+    assert index.find_suffix('example.com') is None
+
+
+def test_comment_and_blank_lines_are_ignored():
+    index = SuffixIndex([
+        '// comment',
+        '',
+        '   ',
+        'com',
+    ])
+    assert index.find_suffix('www.example.com') == 'com'
+
+
+def test_longest_literal_rule_wins():
+    index = SuffixIndex(['com', 'example.com'])
+    assert index.find_suffix('www.example.com') == 'example.com'
+    assert index.find_suffix('www.other.com') == 'com'
+
+
+def test_wildcard_rule_matches_one_label():
+    index = SuffixIndex(['*.ck'])
+    assert index.find_suffix('foo.ck') == 'foo.ck'
+    assert index.find_suffix('ck') is None
+    assert index.find_suffix('bar.foo.ck') == 'foo.ck'
+
+
+def test_wildcard_rule_matches_deeper_parent():
+    index = SuffixIndex(['*.b.ck'])
+    assert index.find_suffix('a.b.ck') == 'a.b.ck'
+    assert index.find_suffix('x.a.b.ck') == 'a.b.ck'
+
+
+def test_exception_rule_excludes_exact_hostname():
+    index = SuffixIndex(['*.ck', '!www.ck'])
+    assert index.find_suffix('www.ck') is None
+    assert index.find_suffix('foo.ck') == 'foo.ck'
+
+
+def test_exception_rule_stops_matching_when_candidate_is_exception():
+    index = SuffixIndex(['*.ck', '!www.ck'])
+    assert index.find_suffix('bar.www.ck') is None
+
+
+def test_hostname_normalization_trailing_dot_and_case():
+    index = SuffixIndex(['com', 'example.com'])
+    assert index.find_suffix('WWW.EXAMPLE.COM.') == 'example.com'
+    assert index.find_suffix('www.example.com') == 'example.com'
+
+
+def test_is_public_suffix_method():
+    index = SuffixIndex(['com', '*.ck', '!www.ck'])
+    assert index.is_public_suffix('com') is True
+    assert index.is_public_suffix('foo.ck') is True
+    assert index.is_public_suffix('www.ck') is False
+    assert index.is_public_suffix('example.com') is False
+
+
+def test_no_match_returns_none():
+    index = SuffixIndex(['com'])
+    assert index.find_suffix('example.org') is None
