+def _resolve_fallback(
+    fallback: dict[str, t.Any] | tuple[type[Signer], dict[str, t.Any]] | type[Signer],
+    default_signer: type[Signer],
+    default_kwargs: dict[str, t.Any],
+) -> tuple[type[Signer], dict[str, t.Any]]:
+    if isinstance(fallback, dict):
+        return default_signer, fallback
+    if isinstance(fallback, tuple):
+        signer_cls, kwargs = fallback
+        return signer_cls, kwargs
+    return fallback, default_kwargs
+
+
+def _iter_fallback_signers(
+    fallback_signers: list[dict[str, t.Any] | tuple[type[Signer], dict[str, t.Any]] | type[Signer]],
+    default_signer: type[Signer],
+    default_kwargs: dict[str, t.Any],
+    secret_keys: cabc.Iterable[str | bytes],
+    salt: str | bytes | None,
+) -> cabc.Iterator[Signer]:
+    for fallback in fallback_signers:
+        signer_cls, kwargs = _resolve_fallback(fallback, default_signer, default_kwargs)
+        for secret_key in secret_keys:
+            yield signer_cls(secret_key, salt=salt, **kwargs)
