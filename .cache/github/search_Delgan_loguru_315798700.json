{"total_count": 2, "incomplete_results": false, "items": [{"url": "https://api.github.com/repos/Delgan/loguru/issues/1001", "repository_url": "https://api.github.com/repos/Delgan/loguru", "labels_url": "https://api.github.com/repos/Delgan/loguru/issues/1001/labels{/name}", "comments_url": "https://api.github.com/repos/Delgan/loguru/issues/1001/comments", "events_url": "https://api.github.com/repos/Delgan/loguru/issues/1001/events", "html_url": "https://github.com/Delgan/loguru/pull/1001", "id": 1921482616, "node_id": "PR_kwDOBfwBzM5bpm92", "number": 1001, "title": "Improve startuptime: don't import IPython/ipykernal if not in jupyter", "user": {"login": "zakstucke", "id": 44890343, "node_id": "MDQ6VXNlcjQ0ODkwMzQz", "avatar_url": "https://avatars.githubusercontent.com/u/44890343?v=4", "gravatar_id": "", "url": "https://api.github.com/users/zakstucke", "html_url": "https://github.com/zakstucke", "followers_url": "https://api.github.com/users/zakstucke/followers", "following_url": "https://api.github.com/users/zakstucke/following{/other_user}", "gists_url": "https://api.github.com/users/zakstucke/gists{/gist_id}", "starred_url": "https://api.github.com/users/zakstucke/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/zakstucke/subscriptions", "organizations_url": "https://api.github.com/users/zakstucke/orgs", "repos_url": "https://api.github.com/users/zakstucke/repos", "events_url": "https://api.github.com/users/zakstucke/events{/privacy}", "received_events_url": "https://api.github.com/users/zakstucke/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "labels": [], "state": "closed", "locked": false, "assignees": [], "milestone": null, "comments": 11, "created_at": "2023-10-02T08:37:04Z", "updated_at": "2024-05-28T13:56:41Z", "closed_at": "2023-10-16T19:06:10Z", "assignee": null, "author_association": "CONTRIBUTOR", "active_lock_reason": null, "draft": false, "pull_request": {"url": "https://api.github.com/repos/Delgan/loguru/pulls/1001", "html_url": "https://github.com/Delgan/loguru/pull/1001", "diff_url": "https://github.com/Delgan/loguru/pull/1001.diff", "patch_url": "https://github.com/Delgan/loguru/pull/1001.patch", "merged_at": "2023-10-16T19:06:09Z"}, "body": "Importing `Ipython/ipykernal` when running from terminal slows startup a fair bit on my machine. \r\n\r\nIf in jupyter `IPython` will already be imported, so can skip the imports directly when not needed. \r\n\r\n```bash\r\ntime python -c \"import loguru\"\r\n```\r\n\r\nBefore:\r\n```\r\n0.31s user 0.06s system 99% cpu 0.374 total\r\n0.22s user 0.02s system 99% cpu 0.242 total\r\n0.20s user 0.03s system 99% cpu 0.237 total\r\n0.21s user 0.03s system 99% cpu 0.242 total\r\n0.22s user 0.03s system 99% cpu 0.245 total\r\n```\r\n\r\nAfter:\r\n```\r\n0.04s user 0.01s system 97% cpu 0.053 total\r\n0.05s user 0.00s system 98% cpu 0.051 total\r\n0.04s user 0.01s system 98% cpu 0.053 total\r\n0.05s user 0.00s system 98% cpu 0.054 total\r\n0.04s user 0.01s system 98% cpu 0.054 total\r\n```\r\n\r\n", "reactions": {"url": "https://api.github.com/repos/Delgan/loguru/issues/1001/reactions", "total_count": 0, "+1": 0, "-1": 0, "laugh": 0, "hooray": 0, "confused": 0, "heart": 0, "rocket": 0, "eyes": 0}, "timeline_url": "https://api.github.com/repos/Delgan/loguru/issues/1001/timeline", "performed_via_github_app": null, "state_reason": null, "score": 1.0}, {"url": "https://api.github.com/repos/Delgan/loguru/issues/935", "repository_url": "https://api.github.com/repos/Delgan/loguru", "labels_url": "https://api.github.com/repos/Delgan/loguru/issues/935/labels{/name}", "comments_url": "https://api.github.com/repos/Delgan/loguru/issues/935/comments", "events_url": "https://api.github.com/repos/Delgan/loguru/issues/935/events", "html_url": "https://github.com/Delgan/loguru/pull/935", "id": 1839043321, "node_id": "PR_kwDOBfwBzM5XUDhg", "number": 935, "title": "Windows 10 and above ANSI support", "user": {"login": "tunaflsh", "id":