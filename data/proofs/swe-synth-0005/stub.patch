+# SPDX-FileCopyrightText: 2023 Your Name
+#
+# SPDX-License-Identifier: Apache-2.0
+
+import pytest
+
+from cachecontrol.vary_matcher import VaryMatcher
+
+
+class TestVaryMatcher:
+    def test_empty_vary_matches_any_request(self):
+        matcher = VaryMatcher(None)
+        assert matcher.matches({"Accept": "text/html"}, {"Accept": "application/json"}) is True
+
+    def test_empty_string_vary_matches_any_request(self):
+        matcher = VaryMatcher("")
+        assert matcher.matches({}, {}) is True
+
+    def test_star_vary_never_matches(self):
+        matcher = VaryMatcher("*")
+        assert matcher.matches({}, {}) is False
+        assert matcher.matches({"Accept": "text/html"}, {"Accept": "text/html"}) is False
+
+    def test_single_field_match(self):
+        matcher = VaryMatcher("Accept-Encoding")
+        cached = {"Accept-Encoding": "gzip"}
+        request = {"Accept-Encoding": "gzip"}
+        assert matcher.matches(cached, request) is True
+
+    def test_single_field_mismatch(self):
+        matcher = VaryMatcher("Accept-Encoding")
+        cached = {"Accept-Encoding": "gzip"}
+        request = {"Accept-Encoding": "br"}
+        assert matcher.matches(cached, request) is False
+
+    def test_multiple_fields_all_match(self):
+        matcher = VaryMatcher("Accept, User-Agent")
+        cached = {"Accept": "text/html", "User-Agent": "pytest"}
+        request = {"Accept": "text/html", "User-Agent": "pytest"}
+        assert matcher.matches(cached, request) is True
+
+    def test_multiple_fields_one_mismatch(self):
+        matcher = VaryMatcher("Accept, User-Agent")
+        cached = {"Accept": "text/html", "User-Agent": "pytest"}
+        request = {"Accept": "text/html", "User-Agent": "requests"}
+        assert matcher.matches(cached, request) is False
+
+    def test_header_name_case_insensitive(self):
+        matcher = VaryMatcher("accept")
+        cached = {"ACCEPT": "text/html"}
+        request = {"Accept": "text/html"}
+        assert matcher.matches(cached, request) is True
+
+    def test_missing_header_treated_as_empty(self):
+        matcher = VaryMatcher("Accept-Language")
+        cached = {"Accept-Language": "en-US"}
+        request = {}
+        assert matcher.matches(cached, request) is False
+
+        cached = {}
+        request = {"Accept-Language": "en-US"}
+        assert matcher.matches(cached, request) is False
+
+        cached = {}
+        request = {}
+        assert matcher.matches(cached, request) is True
+
+    def test_parse_vary_with_spaces_and_case(self):
+        matcher = VaryMatcher("  Accept-Encoding ,  User-Agent  ")
+        assert matcher.parse() == ["accept-encoding", "user-agent"]
+
+    def test_parse_vary_handles_empty_parts(self):
+        matcher = VaryMatcher("Accept,,User-Agent,")
+        assert matcher.parse() == ["accept", "user-agent"]
