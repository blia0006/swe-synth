+# SPDX-License-Identifier: Apache-2.0
+from __future__ import annotations
+
+from typing import Mapping
+
+
+class VaryMatcher:
+    """Match cached responses against request headers using the Vary header."""
+
+    def __init__(self, vary: str | None = None) -> None:
+        """Initialize with the raw Vary header value.
+
+        Args:
+            vary: The value of the ``Vary`` response header, or ``None`` if absent.
+        """
+        raise NotImplementedError("__init__ is not implemented")
+
+    def parse(self) -> list[str] | None:
+        """Parse the Vary header value.
+
+        Returns:
+            A list of lowercased header field names if the Vary header is
+            present and not ``*``. Returns ``None`` when the Vary header is
+            ``None`` or an empty string (meaning no varying). Returns ``None``
+            also for the special value ``*``.
+        """
+        raise NotImplementedError("parse is not implemented")
+
+    def matches(
+        self,
+        cached_headers: Mapping[str, str],
+        request_headers: Mapping[str, str],
+    ) -> bool:
+        """Check if a cached variant matches the current request.
+
+        Args:
+            cached_headers: Headers stored with the cached response. Should
+                contain at least the header fields listed in the Vary header.
+            request_headers: Headers from the current request.
+
+        Returns:
+            ``True`` if the variant can be used, ``False`` otherwise.
+        """
+        raise NotImplementedError("matches is not implemented")
