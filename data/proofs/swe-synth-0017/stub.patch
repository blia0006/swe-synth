+"""Backoff policy sequence generators.
+
+This module provides deterministic backoff sequence generation for
+retry policies. These are pure mathematical functions and do not
+involve any I/O, randomness, or time-dependent behavior.
+"""
+
+from typing import List
+
+
+def fibonacci_backoff(
+    max_attempts: int,
+    initial: float = 1.0,
+    multiplier: float = 1.0,
+) -> List[float]:
+    """Generate a Fibonacci backoff sequence.
+
+    The sequence starts with two elements both equal to `initial`.
+    Each subsequent element is the sum of the previous two elements
+    multiplied by `multiplier`.
+
+    :param max_attempts: Number of attempts to generate. Must be a
+        non-negative integer.
+    :param initial: Base value for the first two elements.
+    :param multiplier: Factor applied to the sum of the previous two
+        elements.
+    :return: A list of floats representing the backoff sequence.
+    :raises TypeError: If `max_attempts` is not an integer.
+    :raises ValueError: If `max_attempts` is negative.
+    """
+    raise NotImplementedError("fibonacci_backoff not implemented")
+
+
+def polynomial_backoff(
+    max_attempts: int,
+    initial: float = 1.0,
+    degree: int = 2,
+    coefficient: float = 1.0,
+) -> List[float]:
+    """Generate a polynomial backoff sequence.
+
+    The k-th element (1-indexed) is computed as::
+
+        initial + coefficient * (k ** degree)
+
+    :param max_attempts: Number of attempts to generate. Must be a
+        non-negative integer.
+    :param initial: Constant offset added to every element.
+    :param degree: Exponent for the polynomial term. Must be a
+        non-negative integer.
+    :param coefficient: Multiplicative factor for the polynomial term.
+    :return: A list of floats representing the backoff sequence.
+    :raises TypeError: If `max_attempts` or `degree` is not an integer.
+    :raises ValueError: If `max_attempts` is negative or `degree` is
+        negative.
+    """
+    raise NotImplementedError("polynomial_backoff not implemented")
diff --git a/tests/test_backoff_policies_synth.py b/tests/test_backoff_policies_synth.py
new file mode 100644
--- /dev/null
+++ b/tests/test_backoff_policies_synth.py
@@ -0,0 +1,68 @@
+import pytest
+
+from tenacity.backoff_policies import fibonacci_backoff, polynomial_backoff
+
+
+def test_fibonacci_default_sequence():
+    """Test default Fibonacci backoff sequence."""
+    expected = [1.0, 1.0, 2.0, 3.0, 5.0]
+    assert fibonacci_backoff(5) == expected
+
+
+def test_fibonacci_with_initial_and_multiplier():
+    """Test Fibonacci with custom initial and multiplier."""
+    expected = [2.0, 2.0, 8.0, 20.0]
+    assert fibonacci_backoff(4, initial=2.0, multiplier=2.0) == expected
+
+
+def test_fibonacci_zero_attempts():
+    """Test Fibonacci for zero attempts returns empty list."""
+    assert fibonacci_backoff(0) == []
+
+
+def test_fibonacci_negative_max_attempts():
+    """Test Fibonacci with negative max_attempts raises ValueError."""
+    with pytest.raises(ValueError):
+        fibonacci_backoff(-1)
+
+
+def test_fibonacci_non_integer_max_attempts():
+    """Test Fibonacci with non-integer max_attempts raises TypeError."""
+    with pytest.raises(TypeError):
+        fibonacci_backoff(3.5)
+
+
+def test_polynomial_default_sequence():
+    """Test default polynomial backoff sequence."""
+    expected = [2.0, 5.0, 10.0, 17.0, 26.0]
+    assert polynomial_backoff(5) == expected
+
+
+def test_polynomial_degree_zero():
+    """Test polynomial backoff with degree zero."""
+    expected = [5.0, 5.0, 5.0]
+    assert polynomial_backoff(3, initial=2.0, degree=0, coefficient=3.0) == expected
+
+
+def test_polynomial_custom_degree_and_coefficient():
+    """Test polynomial backoff with custom degree and coefficient."""
+    expected = [2.5, 16.5, 54.5]
+    assert polynomial_backoff(3, initial=0.5, degree=3, coefficient=2.0) == expected
+
+
+def test_zero_attempts_returns_empty_list():
+    """Test both functions return empty list for zero attempts."""
+    assert fibonacci_backoff(0) == []
+    assert polynomial_backoff(0) == []
+
+
+def test_polynomial_negative_degree():
+    """Test polynomial backoff with negative degree raises ValueError."""
+    with pytest.raises(ValueError):
+        polynomial_backoff(3, degree=-1)
+
+
+def test_polynomial_non_integer_degree():
+    """Test polynomial backoff with non-integer degree raises TypeError."""
+    with pytest.raises(TypeError):
+        polynomial_backoff(3, degree=1.5)
