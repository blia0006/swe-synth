+def _can_use_heuristic(headers: Mapping[str, str], status: int, cacheable_statuses: set[int]) -> bool:
+    if "expires" in headers:
+        return False
+    if "cache-control" in headers and headers["cache-control"] != "public":
+        return False
+    if status not in cacheable_statuses:
+        return False
+    if "date" not in headers or "last-modified" not in headers:
+        return False
+    return True
+
+
+def _parse_date_headers(headers: Mapping[str, str]) -> tuple[int, time.struct_time] | None:
+    time_tuple = parsedate_tz(headers["date"])
+    assert time_tuple is not None
+    date = calendar.timegm(time_tuple[:6])
+    last_modified = parsedate(headers["last-modified"])
+    if last_modified is None:
+        return None
+    return date, last_modified
+
+
+def _compute_expires(date: float, last_modified: time.struct_time, now: float) -> str | None:
+    current_age = max(0, now - date)
+    delta = date - calendar.timegm(last_modified)
+    freshness_lifetime = max(0, min(delta / 10, 24 * 3600))
+    if freshness_lifetime <= current_age:
+        return None
+    expires = date + freshness_lifetime
+    return time.strftime(TIME_FMT, time.gmtime(expires))
