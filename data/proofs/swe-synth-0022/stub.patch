new file mode 100644
--- /dev/null
+++ b/tldextract/idna_utils.py
@@ -0,0 +1,35 @@
+"""Utilities for IDNA encoding and decoding of domain names."""
+
+import idna
+
+
+def to_ascii(hostname: str) -> str:
+    """Convert a possibly Unicode hostname to its ASCII IDNA form.
+
+    Args:
+        hostname: The hostname to convert, possibly containing Unicode
+            characters and trailing dots.
+
+    Returns:
+        The ASCII IDNA-encoded hostname, with no trailing dot.
+
+    Raises:
+        ValueError: If the hostname is not a valid domain name under IDNA.
+    """
+    raise NotImplementedError("to_ascii not implemented")
+
+
+def to_unicode(hostname: str) -> str:
+    """Convert an ASCII IDNA hostname to its Unicode form.
+
+    Args:
+        hostname: The hostname to convert, expected to be ASCII and possibly
+            containing punycode labels.
+
+    Returns:
+        The Unicode hostname, with no trailing dot.
+
+    Raises:
+        ValueError: If the hostname is not a valid IDNA hostname.
+    """
+    raise NotImplementedError("to_unicode not implemented")
diff --git a/tests/test_idna_utils_synth.py b/tests/test_idna_utils_synth.py
new file mode 100644
--- /dev/null
+++ b/tests/test_idna_utils_synth.py
@@ -0,0 +1,47 @@
+"""Tests for tldextract.idna_utils."""
+
+import pytest
+
+from tldextract.idna_utils import to_ascii, to_unicode
+
+
+def test_to_ascii_unicode_domain():
+    assert to_ascii("münich.com") == "xn--mnich-kva.com"
+
+
+def test_to_ascii_strips_trailing_dot_and_lowercases():
+    assert to_ascii("MÜNICH.COM.") == "xn--mnich-kva.com"
+
+
+def test_to_ascii_ascii_domain_unchanged():
+    assert to_ascii("example.com") == "example.com"
+
+
+def test_to_ascii_empty_hostname():
+    assert to_ascii("") == ""
+    assert to_ascii("   ") == ""
+    assert to_ascii(".") == ""
+
+
+def test_to_ascii_invalid_characters():
+    with pytest.raises(ValueError):
+        to_ascii("exa mple.com")
+    with pytest.raises(ValueError):
+        to_ascii("💩.com")
+
+
+def test_to_unicode_punycode_domain():
+    assert to_unicode("xn--mnich-kva.com") == "münich.com"
+
+
+def test_to_unicode_ascii_domain_unchanged():
+    assert to_unicode("example.com") == "example.com"
+
+
+def test_to_unicode_strips_trailing_dot_and_lowercases():
+    assert to_unicode("XN--MNICH-KVA.COM.") == "münich.com"
+
+
+def test_to_unicode_invalid_punycode():
+    with pytest.raises(ValueError):
+        to_unicode("xn--invalid.com")
