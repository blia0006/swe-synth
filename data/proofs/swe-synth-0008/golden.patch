 from __future__ import annotations
 
 from datetime import datetime
+from email.utils import parsedate_to_datetime
 from typing import Mapping
+
+
+def _normalize_headers(headers: Mapping[str, str]) -> dict[str, str]:
+    """将头字段名统一转为小写，便于后续查找。"""
+    return {key.lower(): value for key, value in headers.items()}
+
+
+def _parse_cache_control(value: str) -> list[str]:
+    """解析 Cache-Control 头，返回指令字符串列表（去除空白）。"""
+    return [directive.strip() for directive in value.split(",") if directive.strip()]
+
+
+def _has_directive(directives: list[str], name: str) -> bool:
+    """检查指令列表中是否存在给定名称的指令（无值形式）。"""
+    return any(directive == name for directive in directives)
+
+
+def _get_directive_value(directives: list[str], name: str) -> str | None:
+    """获取指令的值（如 max-age=600 返回 "600"），若无此指令返回 None。"""
+    for directive in directives:
+        if directive == name:
+            return ""
+        if directive.startswith(name + "="):
+            return directive[len(name) + 1:]
+    return None
+
+
+def _parse_date(value: str | None) -> datetime | None:
+    """解析 HTTP 日期字符串，失败返回 None。"""
+    if value is None:
+        return None
+    try:
+        return parsedate_to_datetime(value)
+    except (TypeError, ValueError, IndexError, OverflowError):
+        return None
+
+
+def _parse_age(value: str | None) -> int:
+    """解析 Age 头字符串，返回非负整数，无效或缺失返回 0。"""
+    if value is None:
+        return 0
+    try:
+        age = int(value)
+        if age < 0:
+            return 0
+        return age
+    except (ValueError, TypeError):
+        return 0
 
 
