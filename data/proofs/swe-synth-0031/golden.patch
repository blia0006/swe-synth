+
+def _read_response_body(response: HTTPResponse) -> bytes:
+    body = response.read(decode_content=False)
+    response._fp = io.BytesIO(body)  # type: ignore[assignment]
+    response.length_remaining = len(body)
+    return body
+
+
+def _build_response_data(response: HTTPResponse, body: bytes) -> dict[str, Any]:
+    return {
+        "response": {
+            "body": body,
+            "headers": {str(k): str(v) for k, v in response.headers.items()},
+            "status": response.status,
+            "version": response.version,
+            "reason": str(response.reason),
+            "decode_content": response.decode_content,
+        }
+    }
+
+
+def _build_vary_data(
+    request: PreparedRequest, response_headers: Mapping[str, str]
+) -> dict[str, str | None]:
+    vary: dict[str, str | None] = {}
+    if "vary" not in response_headers:
+        return vary
+
+    varied_headers = response_headers["vary"].split(",")
+    for header in varied_headers:
+        header = str(header).strip()
+        header_value = request.headers.get(header, None)
+        if header_value is not None:
+            header_value = str(header_value)
+        vary[header] = header_value
+    return vary
