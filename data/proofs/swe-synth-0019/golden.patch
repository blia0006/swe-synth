+def _parse_escape(escaping, markup):
+    count = len(escaping)
+    backslashes = "\\" * (count // 2)
+
+    if count % 2 == 1:
+        return [(TokenType.TEXT, backslashes + markup)], True
+
+    if count > 0:
+        return [(TokenType.TEXT, backslashes)], False
+
+    return [], False
+
+
+def _parse_markup_tag(markup):
+    is_closing = markup[1] == "/"
+    tag = markup[2:-1] if is_closing else markup[1:-1]
+    return is_closing, tag
+
+
+def _handle_closing_tag(parser, tag, markup):
+    if parser._tags and (tag == "" or tag == parser._tags[-1]):
+        parser._tags.pop()
+        parser._color_tokens.pop()
+        return [(TokenType.CLOSING, "\033[0m")] + list(parser._color_tokens)
+
+    if tag in parser._tags:
+        raise ValueError('Closing tag "%s" violates nesting rules' % markup)
+
+    raise ValueError('Closing tag "%s" has no corresponding opening tag' % markup)
+
+
+def _get_tag_token(parser, tag, markup):
+    if tag in {"lvl", "level"}:
+        return (TokenType.LEVEL, None)
+
+    ansi = parser._get_ansicode(tag)
+
+    if ansi is None:
+        raise ValueError(
+            'Tag "%s" does not correspond to any known color directive, '
+            "make sure you have not misspelled it (or prepend '\\' to escape it)"
+            % markup
+        )
+
+    return (TokenType.ANSI, ansi)
