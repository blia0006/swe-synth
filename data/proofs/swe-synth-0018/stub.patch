diff --git a/tenacity/retry_after.py b/tenacity/retry_after.py
new file mode 100644
--- /dev/null
+++ b/tenacity/retry_after.py
@@ -0,0 +1,22 @@
+import typing
+from datetime import datetime
+from email.utils import parsedate_to_datetime
+
+
+def parse_retry_after(value: str, now: datetime) -> float | None:
+    '''Parse a Retry-After header value and return the retry delay in seconds.
+
+    The value may be either a non-negative integer number of seconds or an
+    HTTP-date. If the value is a date in the past, the delay is 0.0.
+    If the value cannot be parsed, None is returned.
+    '''
+    raise NotImplementedError
+
+
+def retry_after_delay(headers: typing.Mapping[str, str], now: datetime) -> float | None:
+    '''Extract a Retry-After header from a mapping and compute the delay.
+
+    Header names are matched case-insensitively. If the header is missing
+    or its value cannot be parsed, None is returned.
+    '''
+    raise NotImplementedError
diff --git a/tests/test_retry_after_synth.py b/tests/test_retry_after_synth.py
new file mode 100644
--- /dev/null
+++ b/tests/test_retry_after_synth.py
@@ -0,0 +1,58 @@
+import datetime
+
+from tenacity.retry_after import parse_retry_after, retry_after_delay
+
+
+def test_parse_retry_after_positive_digit():
+    now = datetime.datetime(2023, 1, 1, 0, 0, 0)
+    assert parse_retry_after('120', now) == 120.0
+
+
+def test_parse_retry_after_zero_digit():
+    now = datetime.datetime(2023, 1, 1, 0, 0, 0)
+    assert parse_retry_after('0', now) == 0.0
+
+
+def test_parse_retry_after_negative_digit_returns_none():
+    now = datetime.datetime(2023, 1, 1, 0, 0, 0)
+    assert parse_retry_after('-5', now) is None
+
+
+def test_parse_retry_after_float_string_returns_none():
+    now = datetime.datetime(2023, 1, 1, 0, 0, 0)
+    assert parse_retry_after('1.5', now) is None
+
+
+def test_parse_retry_after_future_http_date():
+    now = datetime.datetime(2023, 1, 1, 0, 0, 0)
+    value = 'Sun, 01 Jan 2023 00:00:30 GMT'
+    assert parse_retry_after(value, now) == 30.0
+
+
+def test_parse_retry_after_past_http_date_returns_zero():
+    now = datetime.datetime(2023, 1, 1, 0, 0, 0)
+    value = 'Sun, 31 Dec 2022 23:59:00 GMT'
+    assert parse_retry_after(value, now) == 0.0
+
+
+def test_parse_retry_after_invalid_string_returns_none():
+    now = datetime.datetime(2023, 1, 1, 0, 0, 0)
+    assert parse_retry_after('not-a-date-or-seconds', now) is None
+
+
+def test_retry_after_delay_missing_header_returns_none():
+    now = datetime.datetime(2023, 1, 1, 0, 0, 0)
+    headers = {'content-type': 'application/json'}
+    assert retry_after_delay(headers, now) is None
+
+
+def test_retry_after_delay_ignores_case():
+    now = datetime.datetime(2023, 1, 1, 0, 0, 0)
+    headers = {'Retry-After': '120'}
+    assert retry_after_delay(headers, now) == 120.0
+
+
+def test_retry_after_delay_returns_parsed_value():
+    now = datetime.datetime(2023, 1, 1, 0, 0, 0)
+    headers = {'RETRY-AFTER': 'Sun, 01 Jan 2023 00:00:30 GMT'}
+    assert retry_after_delay(headers, now) == 30.0
