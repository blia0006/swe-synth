--- a/cachecontrol/cache_control_directives.py
+++ b/cachecontrol/cache_control_directives.py
@@ -13,7 +13,45 @@
     Values are strings, with surrounding double quotes removed. Directives without
     a value map to ``None``.
     '''
-    raise NotImplementedError('Not implemented')
+    if not value:
+        return {}
+
+    parts: list[str] = []
+    current: list[str] = []
+    in_quote = False
+    for char in value:
+        if char == '"':
+            in_quote = not in_quote
+            current.append(char)
+        elif char == ',' and not in_quote:
+            parts.append(''.join(current))
+            current = []
+        else:
+            current.append(char)
+    if current:
+        parts.append(''.join(current))
+
+    directives: dict[str, str | None] = {}
+    for part in parts:
+        part = part.strip()
+        if not part:
+            continue
+
+        if '=' not in part:
+            directives[part.lower()] = None
+            continue
+
+        name, _, val = part.partition('=')
+        name = name.strip().lower()
+        if not name:
+            continue
+
+        val = val.strip()
+        if len(val) >= 2 and val.startswith('"') and val.endswith('"'):
+            val = val[1:-1]
+        directives[name] = val
+
+    return directives
 
 
