+def _derive_concat(signer: Signer, secret_key: bytes) -> bytes:
+    return t.cast(bytes, signer.digest_method(signer.salt + secret_key).digest())
+
+
+def _derive_django_concat(signer: Signer, secret_key: bytes) -> bytes:
+    return t.cast(
+        bytes, signer.digest_method(signer.salt + b"signer" + secret_key).digest()
+    )
+
+
+def _derive_hmac(signer: Signer, secret_key: bytes) -> bytes:
+    mac = hmac.new(secret_key, digestmod=signer.digest_method)
+    mac.update(signer.salt)
+    return mac.digest()
+
+
+def _derive_none(_signer: Signer, secret_key: bytes) -> bytes:
+    return secret_key
+
+
+_DERIVATION_FUNCS: dict[str, t.Callable[[Signer, bytes], bytes]] = {
+    "concat": _derive_concat,
+    "django-concat": _derive_django_concat,
+    "hmac": _derive_hmac,
+    "none": _derive_none,
+}
