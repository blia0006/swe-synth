+import typing
+
+
+def _validate_random_value(value: float) -> None:
+    """Validate that *value* lies in the half-open interval [0, 1).
+
+    :param value: value produced by a random callable
+    :raises ValueError: if *value* is outside [0, 1)
+    """
+    raise NotImplementedError("_validate_random_value")
+
+
+def full_jitter(base_delay: float, random_func: typing.Callable[[], float]) -> float:
+    """Return a jittered delay using the full jitter strategy.
+
+    The result is uniformly distributed in [0, base_delay).
+
+    :param base_delay: non-negative base delay in seconds
+    :param random_func: zero-argument callable returning a float in [0, 1)
+    :returns: jittered delay
+    :raises ValueError: if *base_delay* is negative or *random_func* returns
+        a value outside [0, 1)
+    """
+    raise NotImplementedError("full_jitter")
+
+
+def equal_jitter(base_delay: float, random_func: typing.Callable[[], float]) -> float:
+    """Return a jittered delay using the equal jitter strategy.
+
+    The result is uniformly distributed in [base_delay/2, base_delay).
+
+    :param base_delay: non-negative base delay in seconds
+    :param random_func: zero-argument callable returning a float in [0, 1)
+    :returns: jittered delay
+    :raises ValueError: if *base_delay* is negative or *random_func* returns
+        a value outside [0, 1)
+    """
+    raise NotImplementedError("equal_jitter")
+
+
+def decorrelated_jitter(
+    base_delay: float,
+    previous_delay: float,
+    cap: float,
+    random_func: typing.Callable[[], float],
+) -> float:
+    """Return a jittered delay using the decorrelated jitter strategy.
+
+    The result is uniformly distributed in
+    [base_delay, min(cap, previous_delay * 3)] when that interval is valid.
+    If the upper bound is not greater than base_delay, base_delay is returned.
+
+    :param base_delay: non-negative base delay in seconds
+    :param previous_delay: non-negative previous delay in seconds
+    :param cap: maximum allowed delay; must be >= base_delay
+    :param random_func: zero-argument callable returning a float in [0, 1)
+    :returns: jittered delay
+    :raises ValueError: if any numeric argument is invalid or *random_func*
+        returns a value outside [0, 1)
+    """
+    raise NotImplementedError("decorrelated_jitter")
diff --git a/tests/test_jitter_synth.py b/tests/test_jitter_synth.py
new file mode 100644
--- /dev/null
+++ b/tests/test_jitter_synth.py
@@ -0,0 +1,77 @@
+import typing
+
+import pytest
+
+from tenacity.jitter import (
+    decorrelated_jitter,
+    equal_jitter,
+    full_jitter,
+)
+
+
+def test_full_jitter_basic() -> None:
+    """full_jitter returns base_delay * random_func value."""
+    assert full_jitter(10.0, lambda: 0.25) == pytest.approx(2.5)
+
+
+def test_full_jitter_zero_random_value() -> None:
+    """full_jitter returns 0.0 when random_func returns 0.0."""
+    assert full_jitter(10.0, lambda: 0.0) == pytest.approx(0.0)
+
+
+def test_full_jitter_negative_base_raises() -> None:
+    """full_jitter rejects negative base_delay."""
+    with pytest.raises(ValueError):
+        full_jitter(-1.0, lambda: 0.5)
+
+
+def test_full_jitter_invalid_random_value_raises() -> None:
+    """full_jitter rejects random_func values outside [0, 1)."""
+    with pytest.raises(ValueError):
+        full_jitter(10.0, lambda: -0.1)
+    with pytest.raises(ValueError):
+        full_jitter(10.0, lambda: 1.0)
+
+
+def test_equal_jitter_basic() -> None:
+    """equal_jitter returns half base plus half base times random."""
+    assert equal_jitter(10.0, lambda: 0.5) == pytest.approx(7.5)
+
+
+def test_equal_jitter_extremes() -> None:
+    """equal_jitter respects the [base/2, base) range."""
+    assert equal_jitter(10.0, lambda: 0.0) == pytest.approx(5.0)
+    assert equal_jitter(10.0, lambda: 0.999999) == pytest.approx(9.99999)
+
+
+def test_equal_jitter_negative_base_raises() -> None:
+    """equal_jitter rejects negative base_delay."""
+    with pytest.raises(ValueError):
+        equal_jitter(-1.0, lambda: 0.5)
+
+
+def test_decorrelated_jitter_basic() -> None:
+    """decorrelated_jitter uses previous_delay*3 as upper bound."""
+    assert decorrelated_jitter(1.0, 1.0, 10.0, lambda: 0.5) == pytest.approx(2.0)
+
+
+def test_decorrelated_jitter_previous_zero_returns_base() -> None:
+    """When previous_delay=0, upper bound equals 0, so base is returned."""
+    assert decorrelated_jitter(1.0, 0.0, 10.0, lambda: 0.5) == pytest.approx(1.0)
+
+
+def test_decorrelated_jitter_cap_bounds() -> None:
+    """decorrelated_jitter respects cap."""
+    assert decorrelated_jitter(1.0, 5.0, 10.0, lambda: 0.999999) == pytest.approx(9.999991)
+
+
+def test_decorrelated_jitter_invalid_cap_raises() -> None:
+    """decorrelated_jitter rejects cap < base_delay."""
+    with pytest.raises(ValueError):
+        decorrelated_jitter(2.0, 1.0, 1.5, lambda: 0.5)
+
+
+def test_decorrelated_jitter_negative_previous_raises() -> None:
+    """decorrelated_jitter rejects negative previous_delay."""
+    with pytest.raises(ValueError):
+        decorrelated_jitter(1.0, -1.0, 10.0, lambda: 0.5)
