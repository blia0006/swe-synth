     def warning(self, resp: HTTPResponse) -> str | None:
         return None
+
+
+_FRESHNESS_DIVISOR = 10
+_MAX_FRESHNESS_LIFETIME = 24 * 3600
+
+
+def _has_explicit_expiration(headers: Mapping[str, str]) -> bool:
+    return 'expires' in headers
+
+
+def _has_non_public_cache_control(headers: Mapping[str, str]) -> bool:
+    return 'cache-control' in headers and headers['cache-control'] != 'public'
+
+
+def _parse_revalidation_dates(headers: Mapping[str, str]) -> tuple[int, int] | None:
+    time_tuple = parsedate_tz(headers['date'])
+    assert time_tuple is not None
+    date = calendar.timegm(time_tuple[:6])
+    last_modified = parsedate(headers['last-modified'])
+    if last_modified is None:
+        return None
+    return date, calendar.timegm(last_modified)
+
+
+def _compute_freshness_lifetime(date: int, last_modified: int) -> float:
+    delta = date - last_modified
+    return max(0, min(delta / _FRESHNESS_DIVISOR, _MAX_FRESHNESS_LIFETIME))
+
+
+def _format_expires(date: int, freshness_lifetime: float) -> str:
+    expires = date + freshness_lifetime
+    return time.strftime(TIME_FMT, time.gmtime(expires))
